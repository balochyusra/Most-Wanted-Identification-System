# ============================================================
# Most-Wanted Identification System — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=most_wanted_db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Paths
PHOTOS_DIR=data/photos
SNAPSHOTS_DIR=data/snapshots
LOGS_DIR=data/logs

# Face Recognition
FACE_TOLERANCE=0.5          # Lower = stricter match (0.4–0.6 recommended)
CAMERA_INDEX=0              # 0 = default webcam

# Alert
ALERT_SOUND=False           # Set True if you install playsound
